---
import Base from '../layouts/Base.astro';
import Glossary from '../components/Glossary.svelte';
import { loadAllGames, loadGlossary, loadWords, usedProverbSlugs } from '../lib/content';

// glossary.csv holds every proverb ever written; show only the ones the current games use.
const all = loadGlossary();
const used = usedProverbSlugs(loadAllGames(all));
const entries = all.filter((e) => used.has(e.slug));
const words = loadWords();
---

<Base title="Glossary">
  <Glossary client:load entries={entries} words={words} lang="en" />
</Base>