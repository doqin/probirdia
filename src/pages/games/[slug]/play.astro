---
import Base from '../../../layouts/Base.astro';
import Player from '../../../components/Player.svelte';
import { loadAllGames, loadGlossary, loadWords, glossaryMap } from '../../../lib/content';
import { supabaseConfigured } from '../../../lib/supabase';
import { withBase } from '../../../lib/url';

export function getStaticPaths() {
  return loadAllGames().map((game) => ({ params: { slug: game.slug }, props: { game } }));
}
const { game } = Astro.props;
const glossary = glossaryMap(loadGlossary());
const words = loadWords();
const target = withBase(`/play/?g=${game.slug}`);
---

{supabaseConfigured ? (
  <html lang="en">
    <head>
      <meta charset="utf-8" />
      <meta http-equiv="refresh" content={`0; url=${target}`} />
      <link rel="canonical" href={target} />
      <title>{game.title.en}</title>
    </head>
    <body><a href={target}>{game.title.en}</a></body>
  </html>
) : (
  <Base title={game.title.en} bare>
    <Player client:load game={game} glossary={glossary} words={words} lang="en" />
  </Base>
)}