---
import Base from '../../layouts/Base.astro';
import GameCard from '../../components/GameCard.astro';
import { loadAllGames } from '../../lib/content';
import { t } from '../../i18n/ui';

const games = loadAllGames();
---

<Base title="Games">
  <h1 class="page-title">{t('nav.games')}</h1>
  <ul class="grid">
    {games.map((g) => <li><GameCard game={g} /></li>)}
  </ul>
</Base>

<style>
  .grid { list-style: none; margin: 1.5rem auto 0; padding: 0; display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); max-width: 56rem; }
</style>