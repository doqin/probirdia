---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../lib/url';
import { ClientRouter } from 'astro:transitions';
import partita from '../assets/fonts/Partita1990-Regular.otf?url';
import font400 from '@fontsource/zilla-slab/files/zilla-slab-latin-400-normal.woff2?url';
import font600 from '@fontsource/zilla-slab/files/zilla-slab-latin-600-normal.woff2?url';
import font700 from '@fontsource/zilla-slab/files/zilla-slab-latin-700-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /**
   * A game screen owns the whole viewport: no header, no footer, no page column.
   * The player draws its own HUD inside the artwork.
   */
  bare?: boolean;
}
const { title, description = 'Learn English proverbs by playing choose-your-own-adventure games.', bare = false } = Astro.props;
const fullTitle = title ? `${title} | Probirdia` : 'Probirdia';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="48x48" />
    <link rel="icon" type="image/png" href={withBase('/favicon.png')} sizes="192x192" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    {(bare ? [partita] : [font400, font600, font700]).map((href) => <link rel="preload" as="font" type={href.endsWith('.otf') ? 'font/otf' : 'font/woff2'} href={href} crossorigin />)}
    <ClientRouter />
    <title>{fullTitle}</title>
  </head>
  <body class:list={[{ bare }]}>
    {!bare && <Header overlay={Astro.slots.has('hero')} />}
    <slot name="hero" />
    <main class:list={[{ bare }]}><slot /></main>
    {!bare && <Footer />}
  </body>
</html>
