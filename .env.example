# The content database (Supabase). Copy this file to `.env` and fill it in.
# Project Settings → API keys in the Supabase dashboard.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# The publishable key (sb_publishable_…). It is safe in the browser: row level
# security decides what it may read and write. Older name: the "anon" key.
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Only for `npm run seed`, which signs in as a real editor so RLS lets the
# import write. Not PUBLIC_, so it never reaches the browser bundle.
SUPABASE_EDITOR_EMAIL=you@example.com
SUPABASE_EDITOR_PASSWORD=your-password
