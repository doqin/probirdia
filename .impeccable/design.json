  "narrative": {
    "northStar": "The Proverb Storybook",
    "overview": "Probirdia looks like a printed picture-book that someone has been reading in class: a warm cream page, ink outlines, chunky slabs of Zilla Slab, and things that sit on the paper rather than float above it. Nothing is glossy or app-like. A screen is a page; a character is a cut-out standing on it; the dialogue is a note pinned beside whoever is talking. The system is deliberately two-tier. Chrome (header, footer, page headings, glossary lists) stays quiet and flat — cream ground, ink text, one blurred band at the top. Story objects (speech bubbles, name plates, choice cards, pops) are tactile: 3px ink outline, offset shadow, paper surface. That split is what keeps the game feeling hand-made while the glossary and the editor still read as usable software. Every colour decision follows from the setting too. The palette is paper, leather and ink with a single interactive accent — a saddle brown. The sky blues and rice-paddy greens exist only in scenery, never behind or inside a control, so a button can never be mistaken for a background.",
    "keyCharacteristics": [
      "Cream page, ink text, one brown accent — a three-colour system, not a palette.",
      "Ink outlines plus a hard offset shadow on anything pickable: sticker, not glass.",
      "All-caps labels and headings; sentence-case reading text.",
      "Zilla Slab throughout — a typewriter-slab voice, never a geometric sans.",
      "Scenery (sky, hills, Canva art) is the only place saturated colour appears."
    ],
    "rules": [
      {
        "name": "The One Accent Rule",
        "body": "Saddle Leather Brown is the interaction colour and nothing else. Sky blue and paddy green may never fill a button, a chip, a card or a heading: they belong to scenery, so a control is never camouflaged as background.",
        "section": "colors"
      },
      {
        "name": "The Paper-Or-Object Rule",
        "body": "Each surface is either the page (Warm Paper Cream) or an object lying on it (Bubble Paper / Choice Card Cream with an ink outline). There is no mid-grey panel tier between them.",
        "section": "colors"
      },
      {
        "name": "The Caps Label Rule",
        "body": "Anything that is an interface label is uppercase; anything that is prose stays sentence case. A sentence in caps is always a mistake, and a button in lower case is too.",
        "section": "typography"
      },
      {
        "name": "The One Family Rule",
        "body": "No second typeface is introduced for accent, code or captions. Weight and case carry the contrast.",
        "section": "typography"
      },
      {
        "name": "The Sticker Offset Rule",
        "body": "Shadows on a control are 0-offset-x, small-y, zero blur. A blurred shadow on a button or card is off-brand; blur is reserved for things that actually float above the page.",
        "section": "elevation"
      },
      {
        "name": "The Flat Chrome Rule",
        "body": "Header, footer, page headings, glossary lists and form labels get no shadow and no card treatment. If it is not part of the story, it does not lift.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do put a 3px Ink Brown-Black outline on every story object and give it 0 .35rem 0 rgb(26 18 8 / .25) — no blur.",
      "Do keep the page on Warm Paper Cream and let story objects use Bubble Paper or Choice Card Cream so they read as paper laid on paper.",
      "Do set every interface label in uppercase 700 with ~0.08em tracking, and every sentence in sentence case.",
      "Do use full pills (999px) for controls and soft rectangles (0.8–1.1rem) for paper.",
      "Do reserve Saddle Leather Brown for interaction; the only other brown on a page is the footer band.",
      "Do verify story type at both ends: 1280px desktop and 420px phone, where the bubble drops below the artwork."
    ],
    "donts": [
      "Don't introduce a second typeface, a geometric sans, or a monospace code style.",
      "Don't fill buttons, chips or headings with sky blue or paddy green — those are scenery.",
      "Don't use pure white (#fff) or pure black (#000) surfaces or text; the coldest neutral in use is Cool Stone Grey.",
      "Don't apply blurred, ambient shadows to controls; blur belongs to popovers and hover lifts only.",
      "Don't add gradients, glassmorphism or coloured glows to UI chrome.",
      "Don't centre body prose — centring is for page titles, cards and the game stage.",
      "Don't use red (Chili Brick Red) for anything but a negative state."
    ]
  }
}
